<%= turbo_stream.replace dom_id(@task) do %>
  <%= render "tasks/task", task: @task, just_completed: @just_completed && @task.status? %>
<% end %>

<%= turbo_stream.update "task_list_stats" do %>
  <%= render "task_lists/stats", task_list: @task_list %>
<% end %>

<% if @all_complete %>
  <%= turbo_stream.append "effects" do %>
    <div data-controller="confetti" data-confetti-fire-value="true"></div>
  <% end %>
<% end %>
