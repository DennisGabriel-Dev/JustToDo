<%= form_with(model: task, data: { turbo_frame: "_top" }) do |form| %>
  <% if task.errors.any? %>
    <ul class="form-errors">
      <% task.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "Título", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "O que precisa ser feito?", autofocus: true %>
  </div>

  <div class="form-group form-check">
    <%= form.check_box :status %>
    <%= form.label :status, "Marcar como concluída" %>
  </div>

  <%= form.hidden_field :task_list_id, value: @task_list_id || task.task_list_id %>

  <div class="form-actions">
    <%= form.submit task.persisted? ? "Salvar" : "Criar tarefa", class: "btn btn--primary" %>
  </div>
<% end %>
