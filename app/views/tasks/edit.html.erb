<%= turbo_frame_tag "new_task" do %>
  <div class="pop-up">
    <div class="overlay"></div>
    <div class="modal-custom">
      <h1>Editar tarefa</h1>
      <%= render "form", task: @task %>
      <div class="modal-custom__back">
        <%= link_to "Cancelar", task_list_path(@task.task_list) %>
      </div>
    </div>
  </div>
<% end %>
