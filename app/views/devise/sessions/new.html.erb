<div class="auth-page">
  <div class="auth-card">
    <div class="auth-card__header">
      <div class="auth-card__logo">J</div>
      <h1 class="auth-card__title">Bem-vindo de volta</h1>
      <p class="auth-card__subtitle">Entre para gerenciar suas tarefas</p>
    </div>

    <div class="auth-card__body">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-group">
          <%= f.label :email, "E-mail", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "Senha", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-group form-check">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, "Lembrar de mim" %>
          </div>
        <% end %>

        <div class="form-actions">
          <%= f.submit "Entrar", class: "btn btn--primary", style: "width: 100%;" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
