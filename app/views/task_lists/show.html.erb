<% progress = task_list_progress(@task_list) %>

<nav class="breadcrumb">
  <%= link_to "Listas", task_lists_path %>
  <span class="breadcrumb__sep">/</span>
  <span><%= @task_list.name %></span>
</nav>

<div class="task-board" data-controller="keyboard-shortcuts">
  <div class="task-board__header">
    <div>
      <h2 class="task-board__title"><%= @task_list.name %></h2>
      <p class="task-board__stats" id="task_list_stats"><%= progress[:done] %> de <%= progress[:total] %> concluídas · <%= progress[:percent] %>%</p>
    </div>
    <div class="task-board__toolbar">
      <%= link_to edit_task_list_path(@task_list), class: "btn btn--ghost", data: { turbo_frame: "new_task_list" } do %>
        <i class="fas fa-pen"></i> Editar
      <% end %>
      <%= link_to new_task_path(task_list_id: @task_list),
          class: "btn btn--primary",
          data: { turbo_frame: "new_task", keyboard_shortcuts_target: "newLink" } do %>
        <i class="fas fa-plus"></i> Nova tarefa
      <% end %>
    </div>
  </div>

  <div class="task-filters">
    <%= link_to "Todas", task_list_path(@task_list, filter: "all"), class: task_filter_class(@filter, "all") %>
    <%= link_to "Pendentes", task_list_path(@task_list, filter: "pending"), class: task_filter_class(@filter, "pending") %>
    <%= link_to "Concluídas", task_list_path(@task_list, filter: "done"), class: task_filter_class(@filter, "done") %>
    <%= link_to "Vence hoje", task_list_path(@task_list, filter: "due_today"), class: task_filter_class(@filter, "due_today") %>
  </div>

  <div class="task-rows"
       id="tasks"
       data-controller="sortable"
       data-sortable-url-value="<%= reorder_task_list_path(@task_list) %>">
    <% if @tasks.any? %>
      <% @tasks.each do |task| %>
        <%= render "tasks/task", task: task %>
      <% end %>
    <% else %>
      <%= render "tasks/empty", filter: @filter %>
    <% end %>
  </div>

  <p class="task-board__hint">
    <kbd>N</kbd> nova tarefa · <kbd>Esc</kbd> fechar modal
  </p>
</div>

<div class="form-actions" style="margin-top: 20px;">
  <%= link_to "← Voltar às listas", task_lists_path, class: "btn btn--ghost" %>
  <%= button_to "Apagar lista", @task_list, method: :delete, data: { turbo_confirm: "Quer mesmo apagar esta lista?" }, class: "btn btn--ghost btn--danger" %>
</div>

<%= turbo_frame_tag "new_task_list" %>
<%= turbo_frame_tag "new_task" %>
<div id="effects" aria-hidden="true"></div>
