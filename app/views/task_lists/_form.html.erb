<%= form_with(model: task_list) do |form| %>
  <% if task_list.errors.any? %>
    <ul class="form-errors">
      <% task_list.errors.each do |error| %>
        <li><%= error.message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Nome da lista", class: "form-label" %>
    <%= form.text_field :name,
        placeholder: "Ex: Trabalho da semana",
        class: "form-control",
        autofocus: true %>
  </div>

  <div class="form-actions">
    <%= form.submit task_list.persisted? ? "Salvar" : "Criar lista", class: "btn btn--primary" %>
  </div>
<% end %>
