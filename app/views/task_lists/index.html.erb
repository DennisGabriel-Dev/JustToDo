<% if flash[:notice] %>
  <div class="<%= flash_class(:success) %>"><%= flash[:notice] %></div>
<% end %>

<div class="page-header">
  <div>
    <h2 class="page-header__title">Suas listas</h2>
    <p class="page-header__subtitle"><%= @task_lists.size %> <%= @task_lists.size == 1 ? 'lista' : 'listas' %></p>
  </div>
  <%= link_to new_task_list_path, class: "btn btn--primary", data: { turbo_frame: "new_task_list" } do %>
    <i class="fas fa-plus"></i>
    Nova lista
  <% end %>
</div>

<div class="lists-grid">
  <% if @task_lists.any? %>
    <% @task_lists.each do |task_list| %>
      <%= render "task_list", task_list: task_list %>
    <% end %>
  <% else %>
    <div class="task-board__empty" style="grid-column: 1 / -1; background: var(--surface); border-radius: var(--radius-lg); border: 1px dashed var(--border);">
      <i class="fas fa-folder-open"></i>
      <p>Nenhuma lista ainda. Crie a primeira!</p>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag "new_task_list" %>
