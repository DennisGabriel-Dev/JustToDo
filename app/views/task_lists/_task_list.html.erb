<% progress = task_list_progress(task_list) %>

<article class="list-card" id="<%= dom_id(task_list) %>">
  <div class="list-card__header">
    <%= link_to task_list.name, task_list_path(task_list), class: "list-card__name" %>
    <div class="list-card__actions">
      <%= link_to edit_task_list_path(task_list), class: "btn btn--icon", data: { turbo_frame: "new_task_list" }, title: "Editar" do %>
        <%= pencil_icon %>
      <% end %>
      <%= button_to task_list_path(task_list), method: :delete, data: { turbo_confirm: "Quer mesmo apagar esta lista?" }, class: "btn btn--icon btn--danger", title: "Apagar" do %>
        <%= trash_icon %>
      <% end %>
    </div>
  </div>

  <div class="list-card__meta">
    <span><i class="fas fa-check-circle"></i> <%= progress[:done] %>/<%= progress[:total] %> tarefas</span>
  </div>

  <div class="list-card__progress">
    <div class="list-card__progress-bar" style="width: <%= progress[:percent] %>%"></div>
  </div>
</article>
