<%= turbo_frame_tag "new_task_list" do %>
  <div class="pop-up">
    <div class="overlay"></div>
    <div class="modal-custom">
      <h1>Editar lista</h1>
      <%= render "form", task_list: @task_list %>
      <div class="modal-custom__back">
        <%= link_to "Cancelar", task_list_path(@task_list) %>
      </div>
    </div>
  </div>
<% end %>
