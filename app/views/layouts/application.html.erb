<!DOCTYPE html>
<html lang="pt-BR" data-controller="theme">
  <head>
    <script>
      (function () {
        var theme = localStorage.getItem("theme");
        if (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches) theme = "dark";
        if (!theme) theme = "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <title>JustToDo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <div class="app">
        <%= render "layouts/sidebar" %>
        <div class="app-main">
          <%= render "layouts/header" %>
          <main class="content">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <button type="button" class="auth-theme-toggle" data-action="theme#toggle" aria-label="Alternar tema">
        <i class="fas fa-moon" data-theme-target="icon"></i>
      </button>
      <%= yield %>
    <% end %>
  </body>
</html>
