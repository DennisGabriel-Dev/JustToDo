<header class="topbar">
  <button type="button" class="topbar__menu btn btn--icon" data-action="sidebar#toggle" aria-label="Abrir menu">
    <i class="fas fa-bars"></i>
  </button>

  <h1 class="topbar__title">
    <% if controller_name == 'task_lists' && action_name == 'show' && defined?(@task_list) %>
      <%= @task_list.name %>
    <% elsif controller_name == 'task_lists' && action_name == 'index' %>
      Dashboard
    <% else %>
      JustToDo
    <% end %>
  </h1>

  <% if defined?(@q) && @q %>
    <%= search_form_for @q, class: "topbar__search" do |f| %>
      <i class="fas fa-search topbar__search-icon"></i>
      <%= f.search_field :name_cont, class: "form-control", placeholder: "Buscar listas..." %>
    <% end %>
  <% end %>
</header>
