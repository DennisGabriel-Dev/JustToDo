<aside class="sidebar" data-sidebar-target="sidebar">
  <div class="sidebar__brand">
    <span class="sidebar__brand-icon">J</span>
    JustToDo
  </div>

  <nav class="sidebar__nav">
    <%= link_to task_lists_path, class: "sidebar__link #{'sidebar__link--active' if controller_name == 'task_lists' && action_name.in?(%w[index show])}" do %>
      <i class="fas fa-layer-group"></i>
      Minhas listas
    <% end %>
  </nav>

  <div class="sidebar__footer">
    <div class="sidebar__user"><%= current_user.email %></div>
    <button type="button" class="sidebar__theme" data-action="appearance#toggle">
      <i class="fas fa-moon" data-appearance-icon></i>
      <span data-appearance-label>Modo escuro</span>
    </button>
    <%= button_to destroy_user_session_path, method: :delete, class: "sidebar__logout" do %>
      <i class="fas fa-right-from-bracket"></i>
      Sair
    <% end %>
  </div>
</aside>
